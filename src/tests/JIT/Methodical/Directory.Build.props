<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.props, $(MSBuildThisFileDirectory)..))" />

  <PropertyGroup>
    <RunAnalyzers>true</RunAnalyzers>
    <NoWarn>$(NoWarn);xUnit1013</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      PPC64LE portable/explicit tailcall dispatch is still a bringup gap. Keep
      IL projects that contain explicit tail. calls as known failures until the
      tailcall helper path is implemented for the port.
    -->
    <_Ppc64leUnsupportedTailCallProjects>
      ;25param1c_d;25param1c_r;25param2c_d;25param2c_r;25param3c_d;25param3c_r;25paramMixed_d;25paramMixed_r;
      ;array2_d;array2_r;array3_d;array3_r;
      ;catchfault_tail_d;catchfault_tail_r;catchfinally_tail_il_d;catchfinally_tail_il_r;
      ;compat_enum_d;compat_enum_r;compat_i2_bool_d;compat_i2_bool_r;compat_i4_i1_d;compat_i4_i1_r;compat_i4_u_d;compat_i4_u_r;compat_i_u2_d;compat_i_u2_r;compat_obj_d;compat_obj_r;
      ;compat_r4_r8_d;compat_r4_r8_r;compat_r4_r8_inl_d;compat_r4_r8_inl_r;compat_r8_r4_d;compat_r8_r4_r;compat_r8_r4_inl_d;compat_r8_r4_inl_r;compat_v_d;compat_v_r;
      ;deep_array_d;deep_array_r;deep_array_nz_d;deep_array_nz_r;deep_gc_d;deep_gc_r;deep_inst_d;deep_inst_r;deep_value_d;deep_value_r;deep_virt_d;deep_virt_r;
      ;delegateTail;ehDescriptorPtrUpdate;fgloop;fgloop2;ftn_t_d;ftn_t_r;
      ;gcval_d;gcval_r;gcval_nested_d;gcval_nested_r;gcval_sideeffect_d;gcval_sideeffect_r;
      ;hijacking;hole;indcall_d;indcall_r;instftn_t_d;instftn_t_r;
      ;jumps2_d;jumps2_r;jumps3_d;jumps3_r;jumps4_d;jumps4_r;
      ;pointer_d;pointer_r;recurse_ep_d;recurse_ep_r;recurse_ep_void_d;recurse_ep_void_r;recurse_tail_call_d;recurse_tail_call_r;recurse_tail_calli_d;recurse_tail_calli_r;
      ;reference_i_d;reference_i_r;regionLive;seq_d;seq_r;smallFrame;
      ;tailcall_boxunbox_d;tailcall_boxunbox_r;tailcall_nonvirtualcall_d;tailcall_nonvirtualcall_r;tailjump_d;tailjump_r;
      ;test_2a_d;test_2a_r;test_2b_d;test_2b_r;test_2c_d;test_2c_r;test_3b_d;test_3b_r;test_implicit_d;test_implicit_r;test_mutual_rec_d;test_mutual_rec_r;test_switch_d;test_switch_r;test_virt_d;test_virt_r;test_void_d;test_void_r;
      ;typedref_d;typedref_r;valftn_t_d;valftn_t_r;virtftn_t_d;virtftn_t_r;vtret2_d;vtret2_r;vtret_il_d;vtret_il_r;
    </_Ppc64leUnsupportedTailCallProjects>
    <CLRTestTargetUnsupported Condition="'$(TargetArchitecture)' == 'ppc64le' and $(_Ppc64leUnsupportedTailCallProjects.Contains(';$(MSBuildProjectName);'))">true</CLRTestTargetUnsupported>
  </PropertyGroup>
</Project>
