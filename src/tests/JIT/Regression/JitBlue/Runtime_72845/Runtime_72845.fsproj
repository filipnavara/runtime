<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- PPC64LE portable tailcall dispatch is still a bringup gap; F# list equality reaches it here. -->
    <CLRTestTargetUnsupported Condition="'$(TargetArchitecture)' == 'ppc64le'">true</CLRTestTargetUnsupported>
    <!-- Needed for GCStressIncompatible -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <Optimize>True</Optimize>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <GCStressIncompatible>True</GCStressIncompatible>

    <!-- Not even printf is AOT compatible in F# -->
    <NativeAotIncompatible>true</NativeAotIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Runtime_72845.fs" />
  </ItemGroup>
</Project>
